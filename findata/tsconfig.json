{
  "compilerOptions": {
    "target": "ES2021",
    "module": "ES2020",
    "moduleResolution": "node",
    "lib": [
      "ES2021",
      "DOM"
    ],
    "strict": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "outDir": "site",
    "rootDir": "src"
  },
  "include": [
    "src/**/*.ts"
  ]
}
